# Mapeamento VPS produção — PhRx tenant clone sanitizado
# Copiar para tenant-clone.prod.env (chmod 600) e: source tenant-clone.prod.env
#
# TESTE (destino — podem ser sobrescritos):
#   phrx_tenant_1_branch_1
#   phrx_tenant_1_branch_2
#
# CLIENTE REAL (origem — só leitura/mysqldump; NUNCA destino):
#   phrx_tenant_2_branch_3

export SKALWAY_ROOT=/opt/skalway
export MYSQL_CONTAINER=phrx_mysql
export BACKEND_CONTAINER=phrx_backend

# Bloqueia operações destrutivas no cliente real e na central
export PROTECTED_DATABASES="phrx_tenant_2_branch_3,skalway_central,production,prod"

# Origem / destino por omissão (ajustar target se quiser branch_2)
export TENANT_CLONE_SOURCE_DB=phrx_tenant_2_branch_3
export TENANT_CLONE_TARGET_DB=phrx_tenant_1_branch_1

# Fluxo recomendado:
#   ./infra/scripts/backup-before-tenant-clone.sh --apply
#   ./infra/scripts/tenant-clone-sanitized.sh --source-db=$TENANT_CLONE_SOURCE_DB --target-db=$TENANT_CLONE_TARGET_DB --yes
