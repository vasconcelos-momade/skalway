{
  "name": "phrx-backend",
  "version": "1.0.0",
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "scripts": {
    "prisma:deploy:central": "bash scripts/ensure-central-database-url.sh && bunx prisma db push --schema=src/infrastructure/prisma/central/schema.prisma --accept-data-loss --skip-generate",
    "prisma:migrate:central": "bunx prisma migrate deploy --schema=src/infrastructure/prisma/central/schema.prisma",
    "prisma:migrate:central:data": "bun scripts/migrate-central-enterprise-data.ts",
    "prisma:migrate:central:enterprise": "bash scripts/migrate-central-enterprise.sh",
    "prisma:generate:central": "bunx prisma generate --schema=src/infrastructure/prisma/central/schema.prisma",
    "prisma:generate:tenant": "bunx prisma generate --schema=src/infrastructure/prisma/tenant/schema.prisma",
    "prisma:generate": "bun run prisma:generate:central && bun run prisma:generate:tenant",
    "prisma:deploy:tenant": "bash scripts/ensure-tenant-database-url.sh && bunx prisma db push --schema=src/infrastructure/prisma/tenant/schema.prisma --accept-data-loss --skip-generate",
    "prisma:migrate:tenant": "bash scripts/ensure-tenant-database-url.sh && bunx prisma migrate deploy --schema=src/infrastructure/prisma/tenant/schema.prisma",
    "bootstrap:central": "bash scripts/bootstrap-central.sh",
    "reset:superadmin-password": "bun scripts/reset-superadmin-password.ts",
    "seed:tenant": "bun prisma/seed-tenant.ts",
    "seed:fnm-categorias:all": "bun scripts/seed-fnm-categorias-all-tenants.ts",
    "seed:demo": "bun prisma/seed-demo.ts",
    "billing:generate:monthly": "bun scripts/generate-monthly-billing.ts",
    "billing:process:lifecycle": "bun scripts/process-subscription-lifecycle.ts",
    "dev": "bun run prisma:deploy:central && bun --watch --ignore='**/generated/**' src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/infrastructure/queue/worker.ts",
    "worker:print": "bun src/infrastructure/queue/print-job.worker.ts",
    "db:reset:central-tenants": "echo 'Run this script from the project root: bash scripts/reset-central-and-tenants.sh'"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@skalway/identity": "file:../../../services/identity",
    "@skalway/billing": "file:../../../services/billing",
    "bcryptjs": "^2.4.3",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "puppeteer": "^24.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^8.0.0",
    "prisma": "5.22.0"
  }
}
