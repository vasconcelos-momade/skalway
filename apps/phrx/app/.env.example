# Skalway PhRx — variáveis de build (dart-define)
# O prefixo /api/v1 é acrescentado automaticamente em Env.apiBaseUrlLocal/Cloud.
#
# Se omitir API_BASE_URL, o app escolhe o host por plataforma:
#   Desktop / Web → http://127.0.0.1:4001
#   Emulador Android → http://10.0.2.2:4001
# Dispositivo físico na LAN → --dart-define=API_BASE_URL=http://<IP-da-VM>:4001
# Produção (build_apk.sh / build_deb.sh) → https://api.skalway.com

# API_BASE_URL=http://127.0.0.1:4001
# API_CLOUD_URL=http://127.0.0.1:4001
APP_NAME=Skalway PhRx
