# Skalway PhRx — variáveis de build (dart-define)
# O prefixo /api/v1 é acrescentado automaticamente em Env.apiBaseUrlLocal/Cloud.
#
# Builds empacotados (.deb / APK / AppImage) usam SEMPRE a API remota:
#   https://api-phrx.skalway.com
# URLs locais (localhost, 127.0.0.1, 10.0.2.2, :4001, LAN) são rejeitadas.
#
# Para desenvolvimento local use `flutter run` com dart-define, não os scripts de pacote:
#   Desktop / Web → http://127.0.0.1:4001
#   Emulador Android → http://10.0.2.2:4001
#   Dispositivo físico → http://<IP-da-máquina>:4001

# API_BASE_URL=https://api-phrx.skalway.com
# API_CLOUD_URL=https://api-phrx.skalway.com
APP_NAME=Skalway PhRx
