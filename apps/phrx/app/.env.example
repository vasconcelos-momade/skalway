# Pharma ERP — variáveis de build (dart-define)
# O prefixo /api/v1 é acrescentado automaticamente em Env.apiBaseUrlLocal/Cloud.
#
# Se omitir API_BASE_URL, o app escolhe o host por plataforma:
#   Desktop / Web → http://127.0.0.1:3300
#   Emulador Android → http://10.0.2.2:3300
# Dispositivo físico na LAN → --dart-define=API_BASE_URL=http://<IP-da-VM>:3300

# API_BASE_URL=http://127.0.0.1:3300
# API_CLOUD_URL=http://127.0.0.1:3300
APP_NAME=Pharma ERP
