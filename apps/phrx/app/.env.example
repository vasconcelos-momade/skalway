# Skalway PhRx — variáveis de build (dart-define)
# O prefixo /api/v1 é acrescentado automaticamente em Env.apiBaseUrlLocal/Cloud.
#
# Se omitir API_BASE_URL, o app escolhe o host por plataforma:
#   Desktop / Web → http://127.0.0.1:4001
#   Emulador Android → http://10.0.2.2:4001
# Dispositivo físico na LAN → --dart-define=API_BASE_URL=http://<IP-da-máquina>:4001
# Scripts:
#   build_deb.sh (dev)  → http://127.0.0.1:4001
#   build-apk.sh (dev)  → http://10.0.2.2:4001
#   ENVIRONMENT=prod    → https://api.phrx.skalway.com

# API_BASE_URL=http://10.0.2.2:4001
# API_CLOUD_URL=https://api.phrx.skalway.com
APP_NAME=Skalway PhRx
